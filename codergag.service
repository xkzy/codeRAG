[Unit]
Description=codeRAG MCP Server
After=network.target

[Service]
Type=simple
User=codergag
WorkingDirectory=/opt/codergag
Environment=CODERAG_CONFIG=/etc/codergag/config.yaml
Environment=CODERAG_MAINTENANCE_INTERVAL=15m
Environment=CODERAG_MEMORY_LIMIT_MB=768
ExecStart=/opt/codergag/codergag serve
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

# Resource limits (defence in depth; the process also self-limits its heap)
MemoryHigh=1G
MemoryMax=1536M
TasksMax=512
CPUQuota=200%

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/codergag
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target